# Rust build output
/target
**/*.rs.bk
Cargo.lock.bak

# Editor caches
.vscode/
.idea/
*.swp

# Local pipeline state
.env
data/citygml2/*
!data/citygml2/.gitkeep
data/citygml3/*
!data/citygml3/.gitkeep
data/objs/*
!data/objs/.gitkeep

# Docker build logs
docker-build.log
*-build.log

# Batch processing artefacts
output_batches/
batch_logs/
batch_processing.log
batch_failed_tiles.txt

# GUI venv (gui-modern.sh creates this on first launch)
.venv/
__pycache__/

# Local-only notes, conversation logs, supervisor PDFs, large CSVs.
# Everything inside is private to the working machine and must never be committed.
local comments/

# Chunk manifests (generated by chunk_buildings.py — hundreds of MB, regenerable)
chunks/

# Per-chunk concatenated voxel CSVs (produced by chunk-process.sh)
# Can be tens of GB for Munich, hundreds of GB for full Bavaria.
voxel_csvs/

# Chunk-driver logs and failure list
chunk_processing.log
chunk_failed.txt

# Tensor building: keep build_tensors.py tracked, ignore the heavy/runtime data.
# The glob covers every shard set -- shards/, shards_v5/ (119 MB),
# shards_phase_c/ (1.2 GB) -- so a new one cannot be committed by accident.
tensorbuilding/building_metadata_clean.csv
tensorbuilding/shards*/
tensorbuilding/build_*.log

# Pillar G: participant responses are data, not source
study/responses/

# Model training artefacts — code is tracked, weights/samples are not
model/checkpoints/
model/**/__pycache__/
model/.venv/

# Claude Code local state (private working directory)
.claude/

# One-off scratchpad scripts (never commit these — put finished tools in model/src or tensorbuilding/)
scratchpad_*.py
