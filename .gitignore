# Rust build output
/target
**/*.rs.bk
Cargo.lock.bak

# Editor caches
.vscode/
.idea/
*.swp

# Local pipeline state
.env
data/citygml2/*
!data/citygml2/.gitkeep
data/citygml3/*
!data/citygml3/.gitkeep
data/objs/*
!data/objs/.gitkeep

# Docker build logs
docker-build.log
*-build.log

# Batch processing artefacts
output_batches/
batch_logs/
batch_processing.log
batch_failed_tiles.txt

# GUI venv (gui-modern.sh creates this on first launch)
.venv/
__pycache__/

# Local-only notes, conversation logs, supervisor PDFs, large CSVs.
# Everything inside is private to the working machine and must never be committed.
local comments/

# Chunk manifests (generated by chunk_buildings.py — hundreds of MB, regenerable)
chunks/

# Per-chunk concatenated voxel CSVs (produced by chunk-process.sh)
# Can be tens of GB for Munich, hundreds of GB for full Bavaria.
voxel_csvs/

# Chunk-driver logs and failure list
chunk_processing.log
chunk_failed.txt

# Tensor building: keep build_tensors.py tracked, ignore the heavy/runtime data.
# The glob covers every shard set -- shards/, shards_v5/ (119 MB),
# shards_phase_c/ (1.2 GB) -- so a new one cannot be committed by accident.
tensorbuilding/building_metadata_clean.csv
tensorbuilding/shards*/
tensorbuilding/build_*.log

# Pillar G: participant responses are data, not source
study/responses/

# Model training artefacts — code is tracked, weights/samples are not
model/checkpoints/
model/**/__pycache__/
model/.venv/

# Editor and agent local state (private working directory)
.claude/

# One-off scratchpad scripts (never commit these — put finished tools in scripts/)
scratchpad_*.py
new *.txt

# Web voxeliser job directories (per-job outputs, regenerable)
runs/webjobs/

# Compressed archives of pipeline output (hundreds of GB; delivered out of band)
*.zip
*.tar
*.tar.gz
*.tar.zst

# Local demonstration tools. These drive the pipeline from a browser for
# in-person demos and are not part of the distributed tool. The Cesium ion
# access token under landmarks_pipeline/ is a credential and must never be
# committed.
scripts/
webportal/
landmarks/
landmarks_pipeline/
voxelise-app.sh
generate-app.sh

# This repository is the voxelisation pipeline only. The generative model, the
# tensor-building step and the figures produced from training runs share a
# working tree here but are not tracked on this branch.
model/
tensorbuilding/
figures/
study/
